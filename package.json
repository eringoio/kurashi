{
  "name": "kurashi",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "description": "kurashi（暫定）— 名古屋市で暮らす人が、生活の出来事から知らなかった手続きに気づくための Web アプリ",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --exclude tests/core/drafts-all.test.ts --exclude tests/unit/produce.test.ts --exclude tests/unit/data-update-run.test.ts",
    "test:slow": "vitest run tests/core/drafts-all.test.ts tests/unit/produce.test.ts tests/unit/data-update-run.test.ts",
    "test:a11y": "playwright test",
    "check": "tsc --noEmit && node scripts/furigana.cjs --check && npm test && npm run test:slow && npm run check:quotes && playwright test",
    "icons": "node scripts/make-icons.js",
    "furigana": "node scripts/furigana.cjs",
    "holidays": "node scripts/holidays.mjs",
    "dev:drafts": "vite --mode drafts --port 5174",
    "qr": "node scripts/make-qr.mjs",
    "shots": "node scripts/shots/run.mjs",
    "shots:report": "node scripts/shots/report.mjs",
    "shots:approve": "node scripts/shots/approve.mjs",
    "shots:affected": "node scripts/shots/affected.mjs",
    "check:quotes": "vite-node scripts/check-quotes.ts",
    "data:fetch": "vite-node scripts/fetch-sources.ts --",
    "data:agent": "vite-node scripts/update-agent.ts --",
    "data:apply": "vite-node scripts/apply-update.ts --",
    "deploy": "npm run build && wrangler deploy",
    "worker:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "budoux": "^0.10.3",
    "idb": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@axe-core/playwright": "^4.10.0",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "fake-indexeddb": "^6.0.0",
    "kuromoji": "^0.1.2",
    "linkedom": "^0.18.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.157.0"
  }
}
